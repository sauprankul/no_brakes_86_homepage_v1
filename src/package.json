{
  "name": "no-brakes",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "node scripts/dev.mjs",
    "content:build": "node scripts/build-content-index.mjs",
    "content:watch": "node scripts/build-content-index.mjs --watch",
    "validate:content": "node scripts/validate-content.mjs",
    "media:prepare": "node scripts/generate-sized-media.mjs",
    "media:validate": "node scripts/validate-sized-media.mjs",
    "lint": "eslint .",
    "lint:md": "node scripts/lint-published-markdown.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/article-view.test.mjs test/content-compiler.test.mjs test/collection-filter.test.mjs test/media-pipeline.test.mjs test/published-markdown-files.test.mjs test/repository-boundaries.test.mjs",
    "test:collection": "c8 --all --check-coverage --lines 100 --functions 100 --branches 100 --include=scripts/collection-filter.mjs node --test test/collection-filter.test.mjs",
    "benchmark:refresh": "node scripts/benchmark-content-refresh.mjs",
    "check": "npm run media:validate && npm run validate:content && npm run lint && npm run lint:md && npm run typecheck && npm run test && npm run test:collection",
    "build": "npm run media:validate && node scripts/build-content-index.mjs && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "c8": "^10.1.3",
    "eslint": "^9.17.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "globals": "^17.8.0",
    "markdownlint-cli2": "^0.23.2",
    "marked": "^15.0.7",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.0",
    "yaml": "^2.8.0"
  }
}
