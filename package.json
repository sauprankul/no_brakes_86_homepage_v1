{
  "name": "no-brakes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "content:build": "node scripts/build-content-index.mjs",
    "content:watch": "node scripts/build-content-index.mjs --watch",
    "validate:content": "node scripts/validate-content.mjs",
    "media:sync": "node scripts/sync-media-to-r2.mjs",
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/content-compiler.test.mjs test/collection-filter.test.mjs",
    "test:collection": "c8 --all --check-coverage --lines 100 --functions 100 --branches 100 --include=scripts/collection-filter.mjs node --test test/collection-filter.test.mjs",
    "benchmark:refresh": "node scripts/benchmark-content-refresh.mjs",
    "check": "npm run validate:content && npm run lint && npm run lint:md && npm run typecheck && npm run test && npm run test:collection",
    "build": "node scripts/build-content-index.mjs && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.705.0",
    "@eslint/js": "^9.17.0",
    "c8": "^10.1.3",
    "eslint": "^9.17.0",
    "globals": "^17.8.0",
    "markdownlint-cli2": "^0.15.0",
    "marked": "^15.0.7",
    "sanitize-html": "^2.14.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.0",
    "wrangler": "^3.99.0",
    "yaml": "^2.8.0"
  }
}
